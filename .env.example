# Backend (server.py)
# ANTHROPIC_API_KEY: Claude credentials. Alternatively run `ant auth login` once.
ANTHROPIC_API_KEY=""

# AVATAR_CLAUDE_MODEL / AVATAR_CLAUDE_EFFORT: model and thinking effort for the persona.
AVATAR_CLAUDE_MODEL="claude-opus-5-5"
AVATAR_CLAUDE_EFFORT="low"

# AVATAR_DATA_DIR: where avatars cloned in the studio are stored.
AVATAR_DATA_DIR="data/avatars"

# Frontend (Vite)
# VITE_BACKEND_URL: backend origin. Defaults to port 8000 on the page's host.
VITE_BACKEND_URL="http://localhost:8000"
